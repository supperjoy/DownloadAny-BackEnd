# 服务器部署用环境变量模板：cp 成 .env 后由 scripts/provision-server-env.sh 补全。
# 值为 generate 的两项是占位符，脚本会在服务器本机换成 openssl 随机值，不打印、不进 git。
# ENVIRONMENT 连调阶段保持 development：Cookie 不带 Secure（http 隧道才存得住），
# 且未配 SMTP 时验证码写进容器日志。上生产（域名 + HTTPS + 真实 SMTP）再改 production。
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://downloadany_api:generate@127.0.0.1:3306/downloadany?charset=utf8mb4
DB_PASSWORD=generate
JWT_SECRET=generate
FRONTEND_URL=http://localhost:1420
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
ACTION_TOKEN_MINUTES=15
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
TRUST_PROXY_HEADERS=false
