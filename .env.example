APP_NAME=DownloadAny API
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://root:your-password@127.0.0.1:3306/downloadany?charset=utf8mb4
JWT_SECRET=replace-with-at-least-32-random-characters
# 必须与前端实际 Origin 一致：`tauri dev` 下为 Vite 的 http://localhost:1420；
# 打包后的 Tauri 应用 Origin 不同（macOS 为 tauri://localhost），需另行配置。
FRONTEND_URL=http://localhost:1420
GOOGLE_CLIENT_ID=

# SMTP 留空时，开发环境会把邮件正文打印到控制台。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true

# 只有明确部署在可信反向代理后，才设置为 true。
TRUST_PROXY_HEADERS=false
ACCESS_TOKEN_MINUTES=30
