APP_NAME=DownloadAny API
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://root:your-password@127.0.0.1:3306/downloadany?charset=utf8mb4
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:3000,http://127.0.0.1:3000,http://tauri.localhost,https://tauri.localhost,tauri://localhost
# Google Cloud OAuth 2.0“桌面应用”客户端 ID；与桌面端 VITE_GOOGLE_CLIENT_ID 相同。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 中国大陆等无法直连 Google 的环境可配置，例如 http://127.0.0.1:7897
GOOGLE_PROXY=

# 后端 yt-dlp 访问媒体站点所用代理；部署在可直连环境时留空。
YTDLP_PROXY=
YTDLP_SOCKET_TIMEOUT=20
YTDLP_PARSE_TIMEOUT=75

# SMTP 留空时，开发环境会把邮件正文打印到控制台。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true

# 只有明确部署在可信反向代理后，才设置为 true。
TRUST_PROXY_HEADERS=false
ACCESS_TOKEN_MINUTES=30
